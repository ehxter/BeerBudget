// Istanbul — a private spending companion. One account, one private space.
//
// There is no sharing of any kind: no trips, no memberships, no joint
// expenses. Every row below hangs off a single `userId`, which is the only
// thing that grants access to it.
//
// Money is ALWAYS stored as an integer in the currency's minor unit
// (TRY/USD/EUR = 1/100, TOMAN = 1/1). Never store money as a float.
//
// Turkish Lira is the base currency of the whole app. Anything entered in
// another currency keeps what was actually paid (`amountMinor` + `currency`)
// *and* carries a `baseAmountMinor` in TRY, converted with the rate that was
// in effect when the row was written — so historical totals don't shift when
// today's rate moves.
//
// Iranian currency is represented as TOMAN everywhere (1 Toman = 10 IRR).
// IRR never appears in the database, the API, or the UI.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  budget         Budget?
  expenses       Expense[]
  exchanges      ExchangeTransaction[]
  checklistItems ChecklistItem[]
  vaultFiles     VaultFile[]
  notes          Note[]
  debts          Debt[]
}

model Expense {
  id          String @id @default(cuid())
  userId      String
  description String
  category    String
  // Amount as entered, in `currency` — what was actually handed over.
  amountMinor Int
  currency    String
  // The same amount in Turkish Lira, frozen at the rate below.
  baseAmountMinor Int
  rateToBase      Float
  spentAt         DateTime @default(now())
  note            String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, spentAt])
}

// The one budget figure the Home widget burns down. It never resets — every
// expense ever recorded counts against it.
model Budget {
  id     String @id @default(cuid())
  userId String @unique
  // What the traveler typed, in the currency they chose.
  amountMinor Int
  currency    String @default("TRY")
  // The same figure in Lira, frozen when it was saved. The budget widget only
  // ever renders this one.
  baseAmountMinor Int
  rateToBase      Float    @default(1)
  updatedAt       DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Money owed between the traveler and their one travel companion. There is no
// second account involved: this is a private ledger kept by, and visible only
// to, its owner. The net balance is folded into the Home budget widget —
// money coming back to you raises what you have left to spend, money you owe
// lowers it.
model Debt {
  id     String @id @default(cuid())
  userId String
  // THEY_OWE — the friend owes the traveler (adds to the budget).
  // I_OWE    — the traveler owes the friend (comes off the budget).
  direction   String
  amountMinor Int
  currency    String
  // In Lira, frozen at the rate below, so the net doesn't drift with the market.
  baseAmountMinor Int
  rateToBase      Float
  description     String?
  occurredAt      DateTime  @default(now())
  // Set once the debt is squared up. Settled rows stay for the record but
  // drop out of the net balance and out of the budget.
  settledAt       DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, settledAt])
}

// Cached reference rates, anchored to Toman because that is the unit the
// upstream provider quotes everything in. A cross rate between any two
// currencies is tomanPerUnit[from] / tomanPerUnit[to].
//
// The only table in the schema with no owner — rates are public facts, not
// anybody's private data.
model ExchangeRate {
  id           String   @id @default(cuid())
  currency     String
  tomanPerUnit Float
  source       String // BRSAPI | MANUAL
  fetchedAt    DateTime @default(now())

  @@unique([currency, source])
}

// A currency exchange the traveler actually performed, at a real shop rate.
model ExchangeTransaction {
  id              String   @id @default(cuid())
  userId          String
  fromCurrency    String
  toCurrency      String
  fromAmountMinor Int
  toAmountMinor   Int
  // Units of toCurrency received per 1 unit of fromCurrency.
  effectiveRate   Float
  location        String?
  note            String?
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

// The Vault's first tab: a private checklist.
model ChecklistItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  isDone    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

// The Vault's third tab: free-form notes.
//
// There is no title, deliberately — a note is one piece of text, and forcing a
// name on it turns a five-second capture into a small chore. The list shows
// the body itself, so a note is identified by what it says.
model Note {
  id        String   @id @default(cuid())
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// The Vault's second tab: arbitrary files kept on the server's disk.
//
// The bytes live outside the database under VAULT_DIR, named by `storedName` —
// a random id, never anything derived from what the user uploaded, so a
// crafted filename can't escape the directory or collide with another row.
model VaultFile {
  id     String @id @default(cuid())
  userId String
  /**
   * The label the traveler gave it ("Hotel booking"), which is what the UI
   * shows and what a download is named.
   */
  name String
  /**
   * The name of the file as uploaded. Kept for its extension and for the
   * "originally: passport-scan.pdf" line; never used to build a path.
   */
  originalName String
  /** Random on-disk basename under VAULT_DIR. */
  storedName String @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
